    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BLOG</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BLOG.styles.css" asp-append-version="true" />
</head>
<body class="min-vh-100" style="display: grid;grid-template-rows: auto 1fr auto; ">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">BLOG</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Blog" asp-action="Index">Blog</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-controller="Admin" asp-action="Index">Admin</a>
                        </li>
                        @* <li class="nav-item d-flex ms-auto"> *@
                        @*     <a class="nav-link text-dark" asp-area="" asp-controller="Register" asp-action="Index">Register</a> *@
                        @*     <a class="nav-link text-dark" asp-area="" asp-controller="Login" asp-action="Index">Login</a> *@
                        @* </li> *@
                    </ul>
                    <partial name="_LoginPartial" />

                </div>
            </div>
        </nav>
    </header>
    <main class="d-flex flex-grow-1 w-100">
        <div class="d-flex w-100 h-100">
            <aside class="col-2 border-end p-2 h-100">
                <ul class="navbar-nav flex-column text-center">
                    <li class="nav-item border-bottom">
                        BLOG
                     </li>
                    <li class="nav-item cardhover d-flex justify-content-center ">
                        <a class="nav-link w-100 py-2 text-dark" asp-area="" asp-controller="Admin" asp-action="AddBlog">Add Blog</a>
                    </li>
                    <li class="nav-item cardhover d-flex justify-content-center">
                        
                        <a class="nav-link w-100 py-2 text-dark" asp-area="" asp-controller="Admin" asp-action="listBlog">Blogs</a>
                    </li>
                    <li class="nav-item border-bottom">
                        USER
                    </li>
                    <li class="nav-item cardhover d-flex justify-content-center">
                        <a class="nav-link w-100 py-2 text-dark" asp-area="" asp-controller="Admin" asp-action="AddUser">Add User</a>
                    </li>
                    <li class="nav-item cardhover d-flex justify-content-center">
                        <a class="nav-link w-100 py-2 text-dark" asp-area="" asp-controller="Admin" asp-action="ListUser">Users</a>
                    </li>
                    <li class="nav-item border-bottom">
                        CATEGORY
                    </li>
                    <li class="nav-item cardhover d-flex justify-content-center">
                        <a class="nav-link w-100 py-2 text-dark" asp-area="" asp-controller="Admin" asp-action="AddCategory">Add Category</a>
                    </li>
                    <li class="nav-item cardhover d-flex justify-content-center">
                    <a class="nav-link w-100 py-2 text-dark" asp-area="" asp-controller="Admin" asp-action="ListCategory">Categories</a>
                    </li>
                    <li class="nav-item cardhover d-flex justify-content-center">
                        <a class="nav-link w-100 py-2 text-dark" asp-area="" asp-controller="Admin" asp-action="AssignCategory">Assign</a>
                    </li>
                </ul>
            </aside>
            <content role="main" class="container">
                @RenderBody()
            </content>
       </div>
    </main>

    <footer class="border-top footer text-muted p-3">
        <div class="container">
            &copy; 2025 - BLOG - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
