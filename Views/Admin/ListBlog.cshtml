@{
}

@model List<Post>

<table class="table">
    <thead>
        <tr>
            <th>Título</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var post in Model)
        {
            <tr>
                <td>@post.Title</td>
                <td>
                    <a asp-controller="Blog" asp-action="Edit" asp-route-id="@post.Id" class="btn btn-warning">Editar</a>
                    <a asp-controller="Blog" asp-action="Delete" asp-route-id="@post.Id" class="btn btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>