@{
}
@model BLOG.Models.Post

<section class="col d-flex flex-column gap-3">
    <article class="d-flex flex-column justify-content-center align-items-center p-2 bg-light">
        <h2>@Model.Title</h2>
        <img class="img" width="400" src="@Model.Image" />
        <p class="m-2">
            @Model.Content
        </p>

        <div class="w-75">
            Comentarios:
            <div class="d-flex flex-column gap-2 justify-content-center w-100">
                <form class="d-flex gap-2 flex-column" method="post" asp-controller="Comment" asp-action="Create">
                    <input type="hidden" name="PostId" value="@Model.Id" class="form-control" />
                    <textarea name="Content" class="w-75 p-2" style="resize: none;" placeholder="Write your comment" rows="2"></textarea>
                    <button class="btn btn-primary w-25 ">Publicar</button>
                </form>
                @if (@Model.Comments != null)
                {
                    @foreach (var comment in @Model.Comments)
                    {
                        <comment class="p-2" style="background-color:aliceblue">
                            <div class="bg-opacity-50">
                                <span class="fw-bold fst-italic" style="font-family: Calibri, 'Trebuchet MS', sans-serif">@comment.Author.UserName</span>
                                <time class="text-primary" datetime="@comment.createdAt">
                                    <span class="visually-hidden">Actualizado</span>
                                    @comment.createdAt.ToString("dd 'de' MMMM 'de' yyyy")
                                </time>
                            </div>
                            <p class="m-0">@comment.Content</p>
                            <div class="d-flex gap-2 text-decoration-none">
                                <a href="#">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                                        <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325" />
                                    </svg>
                                </a>
                                <a href="#">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                                        <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z" />
                                        <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" />
                                    </svg>
                                </a>

                            </div>
                        </comment>
                    }
                }
                
            </div>
        </div>
    </article>
</section>